# Mojhometouch — Apache / LiteSpeed rules
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

# Block config, database and hidden files
<FilesMatch "^(config(\.local)?\.php|Dockerfile|render\.yaml|.*\.(sqlite|sqlite3|db|log|md|sql|yml|yaml|sh|ini|conf|json|lock|pid))$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Force HTTPS — uncomment once SSL is active on the domain
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
